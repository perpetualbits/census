# Census LDAP admin tool — configuration template
#
# Copy to ~/.config/census/config.toml and fill in your real values.
# Keep that file out of version control.
#
# The bind password is NEVER stored here. In order of preference census uses:
#   1. password_cmd below (e.g. a secrets manager such as rbw / pass)
#   2. env var:  export CENSUS_BIND_PASSWORD="secret"
#   3. an interactive prompt on startup

[server]
host      = "ldap.example.com"        # LDAP server hostname
port      = 636
use_ssl   = true                       # true → LDAPS  (port 636 typically)
start_tls = false                      # true → plain LDAP + STARTTLS (port 389)
base_dn   = "dc=example,dc=com"
bind_dn   = "cn=admin,dc=example,dc=com"
# password_cmd = "rbw get 'My LDAP'"   # stdout is used as the bind password
# sni     = "ldap.example.com"        # TLS SNI override (default: host)
verify    = true                       # require valid TLS certificate

# Managing an OpenLDAP server's SCHEMA (adding attributeTypes/objectClasses in the
# schema view) needs a cn=config admin — OpenLDAP keeps schema under cn=config, which
# the data bind above can't reach. Set these to enable it. (389 Directory Server
# doesn't need this — it uses the admin bind for schema.)
# config_bind_dn      = "cn=admin,cn=config"
# config_password_cmd = "rbw get 'My LDAP cn=config'"

# How password changes are written:
#   "exop"  → RFC 3062 Password Modify; the server hashes per its policy (default)
#   "crypt" → census writes userPassword: {CRYPT}$6$… (client-side SHA-512)
# password_scheme = "exop"

[tunnel]
# SSH local-forward tunnel.  census will reuse an existing -L forward if one
# is already running, or spawn a new one with ssh -N -L.
enabled     = false
ssh_alias   = "jump.example.com"       # SSH alias from ~/.ssh/config
remote_host = "ldap.example.com"       # LDAP host as seen from the SSH server
remote_port = 636

[display]
# allow_writes = false    # require --write flag to perform any modifications

[browse]
# How the user browse list is ordered (pushed to the server as Server-Side Sort +
# VLV). The defaults sort by `uid` with string ordering — leave them as-is for most
# directories.
#
# If your directory ships a PRECOMPUTED sort-key attribute with a VLV browsing index
# — e.g. an integer `sortRank` giving a surname-then-given order over millions of
# entries — point census at it so an ordered browse hits the index (fast) instead of
# an in-memory re-sort. `sort_attr` must be unique per entry (it doubles as the paging
# key), and `sort_ordering` must be the SAME orderingRule OID the index was built with
# or the server won't use the index.
# sort_attr     = "uid"        # default; e.g. "sortRank"
# sort_ordering = "2.5.13.3"   # caseIgnoreOrderingMatch (string); "2.5.13.15" = integerOrderingMatch

# ── Optional: a human label for this server, shown in the connections rail. ──
# [server] name = "example-prod"   # defaults to the config file's name

# ── Multiple directories at once ──────────────────────────────────────────────
# census can connect to several directories in one session. Two ways to add them:
#
#  1. Multiple DOMAINS on this same server — add [[domain]] blocks. `server.base_dn`
#     above is always the primary domain; each [[domain]] adds another, sharing this
#     server's transport (and, unless overridden, its bind). Handy for one slapd that
#     hosts dc=jive, dc=nova, … as separate suffixes.
#
#  2. Multiple SERVERS — put one .toml file per server in ~/.config/census/conf.d/.
#     census auto-loads them all at startup (filename order) and shows a connections
#     rail. (An explicit `--config FILE` instead loads just that one file.)
#
# When more than one connection is present, the left rail lets you switch focus
# (Enter), mark connections (m), and change a connection's mode (M). Per-connection
# `mode` (below) sets the default; the CLI --write / --dry-run override all.
#
# [[domain]]
# base_dn      = "dc=jive,dc=example,dc=com"
# mode         = "read-only"                 # read-only | write | dry-run  (optional)
#
# [[domain]]
# base_dn      = "dc=nova,dc=example,dc=com"
# mode         = "write"
# bind_dn      = "cn=dm,dc=nova,dc=example,dc=com"   # optional per-domain bind override
# password_cmd = "rbw get 'nova ldap'"              # optional per-domain secret override
