# Copy to .env and tune. Used by compose.yaml and (as plain env) by setup.sh.

# Quick demo scale (seconds to load):
USERS=100000
GROUPS=1000
SSH_USERS=200

# The full corpus we built (a few minutes to generate + bulk-load; needs ~a few
# GB of disk and RAM). Uncomment to use:
# USERS=2000000
# GROUPS=3000
# SSH_USERS=300

# Host port to publish (container listens on 389):
PORT=3389

# Container engine for setup.sh (podman|docker). Leave unset to auto-detect.
# CENSUS_ENGINE=podman
